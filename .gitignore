# Node / dashboard build
node_modules/
dashboard/node_modules/
dashboard/dist/
dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Rebound runtime data & deps (never commit — lives in ~/.rebound, but guard here too)
# NOTE: anchor to repo root so these don't match tracked files like commands/profile.md
.rebound/
pylibs/
/profile.json
/profile.md

# Personal tracker data must never be committed. Only the DUMMY sample is tracked.
# Anchored/scoped so the tracked dummy sample and any docs are unaffected.
/tracker.json
dashboard/public/data/tracker.json
dashboard/public/data/*.local.json

# Generated résumé output (the tool writes these into user folders, keep them out of the repo)
*.pdf
*.docx
*_resumes/
*_smoke.*

# Keep bundled examples (configs are JSON, not ignored)
!examples/**
